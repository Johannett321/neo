{
  "name": "neo",
  "version": "1.2.0",
  "description": "A personal command centre for running several working lives at once.",
  "main": "./out/main/index.js",
  "author": "Johan Svartdal",
  "license": "MIT",
  "homepage": "https://github.com/Johannett321/neo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johannett321/neo.git"
  },
  "bugs": {
    "url": "https://github.com/Johannett321/neo/issues"
  },
  "keywords": [
    "electron",
    "project-management",
    "local-first",
    "pglite",
    "postgres",
    "desktop",
    "personal-knowledge-management"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && electron-vite build && npm run build:mcp && npm run build:audiotap",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:audiotap": "node scripts/build-audiotap.mjs",
    "mcp:pack": "node scripts/build-mcp.mjs && node scripts/mcp-bundle.mjs",
    "dev": "node scripts/dev-branding.mjs && node scripts/build-audiotap.mjs && electron-vite dev",
    "dist": "npm run build && electron-builder",
    "package": "npm run build && electron-builder --dir",
    "postinstall": "node scripts/dev-branding.mjs",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "verify": "esbuild test/verify.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/verify.mjs --external:@electric-sql/pglite --external:openai --alias:electron=./test/electron-stub.mjs --alias:@shared=./src/shared && node out/verify.mjs",
    "verify:upgrade": "esbuild test/upgrade.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/upgrade.mjs --external:@electric-sql/pglite --external:openai --alias:electron=./test/electron-stub.mjs --alias:@shared=./src/shared && node out/upgrade.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.64.1",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "framer-motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
